# --- Chat LLM (vLLM, OpenAI-mos) ---
VLLM_BASE_URL=https://your-vllm-endpoint/v1
VLLM_API_KEY=your-key
VLLM_MODEL=gemma4-31b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1500

# --- PostgreSQL (READ-ONLY) ---
DB_HOST=192.168.1.7
DB_PORT=5432
DB_NAME=limsdb
DB_USER=limsdb-read-user
DB_PASSWORD=your-readonly-password
DB_INCLUDE_SCHEMAS=public

# --- Xavfsizlik ---
SQL_ROW_LIMIT=500
MAX_ROWS_TO_MODEL=20
STATEMENT_TIMEOUT_MS=15000
SCHEMA_CHAR_BUDGET=24000
MAX_SQL_ATTEMPTS=3

CORS_ALLOW_ORIGINS=*

# --- Avtorizatsiya (HTTP Basic, barcha endpointlar). Bo'sh bo'lsa — hamma so'rov rad etiladi ---
API_USERNAME=lims_admin
API_PASSWORD=kuchli-parol-yozing

# --- Suhbat xotirasi (alohida PostgreSQL, YOZISH huquqi bilan). Bo'sh bo'lsa — jarayon xotirasi ---
# Jadvallar: <prefix>_sessions, <prefix>_messages (birinchi murojaatda o'zi yaratiladi)
CHAT_DB_HOST=192.168.1.27
CHAT_DB_PORT=5432
CHAT_DB_NAME=atilaidb
CHAT_DB_USER=your-chat-db-user
CHAT_DB_PASSWORD=your-chat-db-password
CHAT_DB_SCHEMA=public
CHAT_DB_TABLE_PREFIX=lims_chatbot
